                <target>Das Modell „%1$s“ kann Werkzeuge aufrufen; das braucht der Chat zum Nachsehen und für Änderungen.</target>
            </trans-unit>
            <trans-unit id="readiness.tools.missing" resname="readiness.tools.missing">
