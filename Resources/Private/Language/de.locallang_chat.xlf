<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2025-01-01T00:00:00Z" product-name="nr_mcp_agent">
        <body>
            <!-- Panel header -->
            <trans-unit id="panel.title" resname="panel.title">
                <source>AI Chat</source>
                <target>KI-Chat</target>
            </trans-unit>
            <trans-unit id="panel.collapse" resname="panel.collapse">
                <source>Minimize</source>
                <target>Minimieren</target>
            </trans-unit>
            <trans-unit id="panel.maximize" resname="panel.maximize">
                <source>Maximize</source>
                <target>Maximieren</target>
            </trans-unit>
            <trans-unit id="panel.restore" resname="panel.restore">
                <source>Restore</source>
                <target>Wiederherstellen</target>
            </trans-unit>
            <trans-unit id="panel.popOut" resname="panel.popOut" approved="yes">
                <source>Open in a separate window</source>
                <target>In eigenem Fenster öffnen</target>
            </trans-unit>
            <trans-unit id="panel.close" resname="panel.close">
                <source>Close</source>
                <target>Schließen</target>
            </trans-unit>
            <trans-unit id="panel.resize" resname="panel.resize">
                <source>Resize panel</source>
                <target>Fenstergröße ändern</target>
            </trans-unit>

            <!-- Sidebar -->
            <trans-unit id="sidebar.show" resname="sidebar.show">
                <source>Show sidebar</source>
                <target>Seitenleiste einblenden</target>
            </trans-unit>
            <trans-unit id="sidebar.hide" resname="sidebar.hide">
                <source>Hide sidebar</source>
                <target>Seitenleiste ausblenden</target>
            </trans-unit>

            <!-- Conversations -->
            <trans-unit id="conversations.title" resname="conversations.title">
                <source>Chats</source>
                <target>Chats</target>
            </trans-unit>
            <trans-unit id="conversations.new" resname="conversations.new">
                <source>New chat</source>
                <target>Neuer Chat</target>
            </trans-unit>
            <trans-unit id="conversations.empty" resname="conversations.empty">
                <source>No chats yet. Start a new one!</source>
                <target>Noch keine Chats. Starte jetzt einen!</target>
            </trans-unit>
            <trans-unit id="conversations.select" resname="conversations.select">
                <source>Select chat...</source>
                <target>Chat auswählen...</target>
            </trans-unit>
            <trans-unit id="conversations.newConversation" resname="conversations.newConversation">
                <source>New chat</source>
                <target>Neuer Chat</target>
            </trans-unit>
            <trans-unit id="conversations.pin" resname="conversations.pin">
                <source>Pin</source>
                <target>Anheften</target>
            </trans-unit>
            <trans-unit id="conversations.unpin" resname="conversations.unpin">
                <source>Unpin</source>
                <target>Lösen</target>
            </trans-unit>
            <trans-unit id="conversations.archive" resname="conversations.archive">
                <source>Archive</source>
                <target>Archivieren</target>
            </trans-unit>
            <trans-unit id="conversations.archiveConfirm" resname="conversations.archiveConfirm">
                <source>Archive this chat? You can find it later in the full chat module.</source>
                <target>Diesen Chat archivieren? Du findest ihn später im Chat-Modul.</target>
            </trans-unit>
            <trans-unit id="conversations.more" resname="conversations.more">
                <source>More (%d)</source>
                <target>Weitere (%d)</target>
            </trans-unit>
            <trans-unit id="conversations.moreTitle" resname="conversations.moreTitle">
                <source>Show the conversations that do not fit in the row</source>
                <target>Unterhaltungen anzeigen, die nicht in die Leiste passen</target>
            </trans-unit>
            <trans-unit id="conversations.search" resname="conversations.search">
                <source>Search conversations</source>
                <target>Unterhaltungen durchsuchen</target>
            </trans-unit>
            <trans-unit id="conversations.noMatch" resname="conversations.noMatch">
                <source>No conversation matches</source>
                <target>Keine Unterhaltung gefunden</target>
            </trans-unit>
            <trans-unit id="conversations.export" resname="conversations.export">
                <source>Export conversation as Markdown</source>
                <target>Unterhaltung als Markdown exportieren</target>
            </trans-unit>
            <trans-unit id="conversations.exportShort" resname="conversations.exportShort">
                <source>Export</source>
                <target>Exportieren</target>
            </trans-unit>
            <trans-unit id="export.roleUser" resname="export.roleUser">
                <source>You</source>
                <target>Du</target>
            </trans-unit>
            <trans-unit id="export.roleAssistant" resname="export.roleAssistant">
                <source>Assistant</source>
                <target>Assistent</target>
            </trans-unit>
            <trans-unit id="export.attachment" resname="export.attachment">
                <source>Attachment</source>
                <target>Anhang</target>
            </trans-unit>

            <!-- Chat -->
            <trans-unit id="chat.selectOrCreate" resname="chat.selectOrCreate">
                <source>Select or start a chat</source>
                <target>Chat auswählen oder neuen starten</target>
            </trans-unit>
            <trans-unit id="chat.empty.title" resname="chat.empty.title" approved="yes">
                <source>Ask about this TYPO3 installation</source>
                <target>Frag zu dieser TYPO3-Installation</target>
            </trans-unit>
            <trans-unit id="chat.empty.body" resname="chat.empty.body" approved="yes">
                <source>The assistant can look things up in this installation and act on them — find pages and content, explain how something is configured, and prepare changes for you to review.</source>
                <target>Der Assistent kann in dieser Installation nachsehen und darin arbeiten: Seiten und Inhalte finden, erklären wie etwas konfiguriert ist, und Änderungen vorbereiten, die du prüfen kannst.</target>
            </trans-unit>
            <trans-unit id="chat.empty.hint" resname="chat.empty.hint" approved="yes">
                <source>Earlier conversations stay in the list on the left.</source>
                <target>Frühere Unterhaltungen bleiben links in der Liste.</target>
            </trans-unit>
            <trans-unit id="chat.empty.hintTabs" resname="chat.empty.hintTabs">
                <source>Earlier conversations are in the row above; the ones that do not fit in it are under “More”.</source>
                <target>Frühere Unterhaltungen stehen in der Leiste darüber; was dort keinen Platz hat, findest du unter „Weitere“.</target>
            </trans-unit>
            <trans-unit id="chat.notAvailable" resname="chat.notAvailable">
                <source>Chat not available. Please contact your administrator.</source>
                <target>Chat nicht verfügbar. Bitte kontaktiere deinen Administrator.</target>
            </trans-unit>
            <trans-unit id="chat.processing" resname="chat.processing">
                <source>Processing...</source>
                <target>Wird verarbeitet...</target>
            </trans-unit>
            <trans-unit id="chat.approvalPending" resname="chat.approvalPending">
                <source>Waiting for approval</source>
                <target>Freigabe ausstehend</target>
            </trans-unit>
            <trans-unit id="chat.approvalPendingDetail" resname="chat.approvalPendingDetail">
                <source>This step writes data and needs an approval before it runs.</source>
                <target>Dieser Schritt schreibt Daten und braucht eine Freigabe, bevor er ausgeführt wird.</target>
            </trans-unit>
            <trans-unit id="chat.approvalOpen" resname="chat.approvalOpen">
                <source>Open the run in AI Tasks</source>
                <target>Lauf in AI Tasks öffnen</target>
            </trans-unit>
            <trans-unit id="chat.approvalApprove" resname="chat.approvalApprove">
                <source>Approve</source>
                <target>Freigeben</target>
            </trans-unit>
            <trans-unit id="chat.approvalGranted" resname="chat.approvalGranted">
                <source>Approval granted — the assistant is carrying the step out.</source>
                <target>Freigabe erteilt — der Assistent führt den Schritt aus.</target>
            </trans-unit>
            <trans-unit id="chat.approvalDenied" resname="chat.approvalDenied">
                <source>Approval denied — the step was not carried out.</source>
                <target>Freigabe abgelehnt — der Schritt wurde nicht ausgeführt.</target>
            </trans-unit>
            <trans-unit id="chat.approvalDeny" resname="chat.approvalDeny">
                <source>Deny</source>
                <target>Ablehnen</target>
            </trans-unit>
            <trans-unit id="chat.approvalPreview" resname="chat.approvalPreview">
                <source>What this call would do</source>
                <target>Was dieser Aufruf tun würde</target>
            </trans-unit>
            <trans-unit id="chat.approvalPreviewUnavailable" resname="chat.approvalPreviewUnavailable">
                <source>No preview — you are deciding without one</source>
                <target>Keine Vorschau — die Entscheidung fällt ohne</target>
            </trans-unit>
            <trans-unit id="chat.approvalPreviewStale" resname="chat.approvalPreviewStale">
                <source>This record changed after the preview you approved, so nothing was written. The preview shows its current state — please check it and decide again.</source>
                <target>Der Datensatz hat sich nach der freigegebenen Vorschau geändert, deshalb wurde nichts geschrieben. Die Vorschau zeigt den aktuellen Stand — bitte prüfen und erneut entscheiden.</target>
            </trans-unit>
            <trans-unit id="chat.approvalArguments" resname="chat.approvalArguments">
                <source>Arguments</source>
                <target>Argumente</target>
            </trans-unit>
            <trans-unit id="chat.approvalToolGone" resname="chat.approvalToolGone">
                <source>The tool for this call is no longer registered.</source>
                <target>Das Werkzeug für diesen Aufruf ist nicht mehr registriert.</target>
            </trans-unit>
            <trans-unit id="chat.approvalUnreadable" resname="chat.approvalUnreadable">
                <source>This run cannot be read here. Open it in AI Tasks.</source>
                <target>Dieser Lauf lässt sich hier nicht lesen. Im Modul AI Tasks öffnen.</target>
            </trans-unit>
            <trans-unit id="chat.errorPrefix" resname="chat.errorPrefix">
                <source>Error:</source>
                <target>Fehler:</target>
            </trans-unit>
            <trans-unit id="chat.retry" resname="chat.retry">
                <source>Retry</source>
                <target>Erneut versuchen</target>
            </trans-unit>
            <trans-unit id="chat.dismiss" resname="chat.dismiss">
                <source>Dismiss</source>
                <target>Schließen</target>
            </trans-unit>
            <trans-unit id="chat.send" resname="chat.send">
                <source>Send</source>
                <target>Senden</target>
            </trans-unit>
            <trans-unit id="chat.placeholder" resname="chat.placeholder">
                <source>Ask anything...</source>
                <target>Frag einfach...</target>
            </trans-unit>
            <trans-unit id="chat.connectionLost" resname="chat.connectionLost">
                <source>Connection lost — reconnecting...</source>
                <target>Verbindung unterbrochen — wird wiederhergestellt...</target>
            </trans-unit>
            <trans-unit id="chat.messageTooLong" resname="chat.messageTooLong">
                <source>Message exceeds %d character limit</source>
                <target>Nachricht überschreitet das Limit von %d Zeichen</target>
            </trans-unit>
            <trans-unit id="chat.nothingSaved" resname="chat.nothingSaved">
                <source>Nothing was saved in this step.</source>
                <target>In diesem Schritt wurde nichts gespeichert.</target>
            </trans-unit>
            <trans-unit id="chat.runFinishedOutside" resname="chat.runFinishedOutside">
                <source>The approval was decided outside this chat, and the run has finished there. It wrote: %s. Its answer is under AI Tasks.</source>
                <target>Die Freigabe wurde außerhalb dieses Chats entschieden, und der Lauf ist dort abgeschlossen. Er hat geschrieben: %s. Seine Antwort steht unter AI Tasks.</target>
            </trans-unit>
            <trans-unit id="chat.runFinishedOutsideNothingWritten" resname="chat.runFinishedOutsideNothingWritten">
                <source>The approval was decided outside this chat, and the run has finished there without writing anything. Its answer is under AI Tasks.</source>
                <target>Die Freigabe wurde außerhalb dieses Chats entschieden, und der Lauf ist dort abgeschlossen, ohne etwas zu schreiben. Seine Antwort steht unter AI Tasks.</target>
            </trans-unit>

            <!-- Tool messages -->
            <trans-unit id="tool.output" resname="tool.output">
                <source>Tool result (click to expand)</source>
                <target>Tool-Ergebnis (klicken zum Aufklappen)</target>
            </trans-unit>

            <!-- API refusals shown in the chat notice -->
            <trans-unit id="error.approvalNotAllowed" resname="error.approvalNotAllowed">
                <source>Not allowed to decide approvals</source>
                <target>Keine Berechtigung, Freigaben zu entscheiden</target>
            </trans-unit>
            <trans-unit id="error.notAwaitingApproval" resname="error.notAwaitingApproval">
                <source>Conversation is not waiting for an approval</source>
                <target>Der Chat wartet nicht auf eine Freigabe</target>
            </trans-unit>
            <trans-unit id="error.decisionInFlight" resname="error.decisionInFlight">
                <source>An approval decision for this conversation is still being carried out</source>
                <target>Eine Freigabeentscheidung für diesen Chat wird noch ausgeführt</target>
            </trans-unit>
            <trans-unit id="error.conversationProcessing" resname="error.conversationProcessing">
                <source>Conversation is already processing</source>
                <target>Der Chat wird bereits verarbeitet</target>
            </trans-unit>
            <trans-unit id="error.notResumable" resname="error.notResumable">
                <source>Conversation is not resumable</source>
                <target>Der Chat lässt sich nicht fortsetzen</target>
            </trans-unit>
            <trans-unit id="error.conversationNotFound" resname="error.conversationNotFound">
                <source>Conversation not found</source>
                <target>Chat nicht gefunden</target>
            </trans-unit>
            <trans-unit id="error.accessDenied" resname="error.accessDenied">
                <source>Access denied</source>
                <target>Zugriff verweigert</target>
            </trans-unit>
            <trans-unit id="error.approvalStillPending" resname="error.approvalStillPending">
                <source>This step is still waiting for a decision. Approve or deny it on the card — a message does not approve it.</source>
                <target>Dieser Schritt wartet noch auf eine Entscheidung. Bitte auf der Karte freigeben oder ablehnen – eine Nachricht erteilt keine Freigabe.</target>
            </trans-unit>
            <trans-unit id="error.approvalStillPendingElsewhere" resname="error.approvalStillPendingElsewhere">
                <source>This step is still waiting for an approval in AI Tasks — a message does not approve it.</source>
                <target>Dieser Schritt wartet noch auf eine Freigabe in AI Tasks – eine Nachricht erteilt keine Freigabe.</target>
            </trans-unit>
            <trans-unit id="error.providerNotConfigured" resname="error.providerNotConfigured">
                <source>The AI provider is not set up. Please contact your administrator.</source>
                <target>Der KI-Anbieter ist nicht eingerichtet. Bitte an die Administration wenden.</target>
            </trans-unit>
            <trans-unit id="error.chatNotConfigured" resname="error.chatNotConfigured">
                <source>The AI chat is not set up. Please contact your administrator.</source>
                <target>Der KI-Chat ist nicht eingerichtet. Bitte an die Administration wenden.</target>
            </trans-unit>
            <trans-unit id="error.openProviders" resname="error.openProviders">
                <source>Open the LLM providers</source>
                <target>LLM-Provider öffnen</target>
            </trans-unit>
            <trans-unit id="error.openTasks" resname="error.openTasks">
                <source>Open the LLM tasks</source>
                <target>LLM-Tasks öffnen</target>
            </trans-unit>

            <!-- Attachments -->
            <trans-unit id="attachment.attach" resname="attachment.attach">
                <source>Attach file</source>
                <target>Datei anhängen</target>
            </trans-unit>
            <trans-unit id="attachment.upload" resname="attachment.upload">
                <source>Upload file</source>
                <target>Datei hochladen</target>
            </trans-unit>
            <trans-unit id="attachment.fromFal" resname="attachment.fromFal">
                <source>From file list</source>
                <target>Aus Dateiliste</target>
            </trans-unit>
            <trans-unit id="attachment.notSupported" resname="attachment.notSupported">
                <source>Your LLM model does not support file attachments</source>
                <target>Ihr LLM-Modell unterstützt keine Dateianhänge</target>
            </trans-unit>
            <trans-unit id="attachment.tooLarge" resname="attachment.tooLarge">
                <source>File too large (max %d MB)</source>
                <target>Datei zu groß (max. %d MB)</target>
            </trans-unit>
            <trans-unit id="attachment.limitReached" resname="attachment.limitReached">
                <source>Maximum 5 files per conversation reached</source>
                <target>Maximum 5 Dateien pro Chat erreicht</target>
            </trans-unit>
            <trans-unit id="attachment.invalidType" resname="attachment.invalidType">
                <source>File type not supported</source>
                <target>Dateityp nicht unterstützt</target>
            </trans-unit>
            <trans-unit id="attachment.file" resname="attachment.file">
                <source>File</source>
                <target>Datei</target>
            </trans-unit>
            <trans-unit id="attachment.remove" resname="attachment.remove">
                <source>Remove attachment</source>
                <target>Anhang entfernen</target>
            </trans-unit>
            <trans-unit id="attachment.uploading" resname="attachment.uploading">
                <source>Uploading...</source>
                <target>Wird hochgeladen...</target>
            </trans-unit>
            <trans-unit id="attachment.fileMissing" resname="attachment.fileMissing">
                <source>File no longer available</source>
                <target>Datei nicht mehr verfügbar</target>
            </trans-unit>

            <!-- FAL picker -->
            <trans-unit id="fal_picker_label" resname="fal_picker_label">
                <source>Select file</source>
                <target>Datei auswählen</target>
            </trans-unit>
            <trans-unit id="fal_picker_unavailable" resname="fal_picker_unavailable">
                <source>FAL picker is not available</source>
                <target>Die Dateiauswahl ist nicht verfügbar</target>
            </trans-unit>
            <trans-unit id="fal_picker_popup_blocked" resname="fal_picker_popup_blocked">
                <source>Popup was blocked. Please disable your popup blocker.</source>
                <target>Das Popup wurde blockiert. Bitte deaktiviere deinen Popup-Blocker.</target>
            </trans-unit>
            <trans-unit id="chat.edit" resname="chat.edit">
                <source>Edit</source>
                <target>Bearbeiten</target>
            </trans-unit>
            <trans-unit id="chat.editMessage" resname="chat.editMessage">
                <source>Edit this message and run the conversation again from here</source>
                <target>Diese Nachricht bearbeiten und die Unterhaltung ab hier neu ausführen</target>
            </trans-unit>
            <trans-unit id="chat.editHint" resname="chat.editHint">
                <source>Saving replaces this message and removes everything after it; the assistant then answers again.</source>
                <target>Beim Speichern wird diese Nachricht ersetzt und alles danach entfernt; der Assistent antwortet dann neu.</target>
            </trans-unit>
            <trans-unit id="chat.editCancel" resname="chat.editCancel">
                <source>Cancel</source>
                <target>Abbrechen</target>
            </trans-unit>
            <trans-unit id="chat.editSubmit" resname="chat.editSubmit">
                <source>Save and run again</source>
                <target>Speichern und neu ausführen</target>
            </trans-unit>
            <trans-unit id="instructions.button" resname="instructions.button">
                <source>Instructions for this conversation</source>
                <target>Anweisungen für diese Unterhaltung</target>
            </trans-unit>
            <trans-unit id="instructions.buttonSet" resname="instructions.buttonSet">
                <source>Instructions for this conversation (set)</source>
                <target>Anweisungen für diese Unterhaltung (gesetzt)</target>
            </trans-unit>
            <trans-unit id="instructions.buttonShort" resname="instructions.buttonShort">
                <source>Instructions</source>
                <target>Anweisungen</target>
            </trans-unit>
            <trans-unit id="instructions.label" resname="instructions.label">
                <source>Instructions for this conversation</source>
                <target>Anweisungen für diese Unterhaltung</target>
            </trans-unit>
            <trans-unit id="instructions.help" resname="instructions.help">
                <source>They are added to the instructions configured for the chat, which stay in force and win where the two contradict each other. They apply from the next message on. The assistant's identity, its tools and permissions, and the rules about languages stay the same. Leave the field empty to remove them.</source>
                <target>Sie ergänzen die für den Chat konfigurierten Anweisungen; diese bleiben gültig und haben Vorrang, wo sich beide widersprechen. Deine Anweisungen gelten ab der nächsten Nachricht. Identität des Assistenten, seine Werkzeuge und Berechtigungen sowie die Regeln zu Sprachen bleiben gleich. Leere das Feld, um sie zu entfernen.</target>
            </trans-unit>
            <trans-unit id="instructions.save" resname="instructions.save">
                <source>Save instructions</source>
                <target>Anweisungen speichern</target>
            </trans-unit>
            <trans-unit id="error.notEditable" resname="error.notEditable">
                <source>Only a message you wrote as text can be edited</source>
                <target>Nur eine Nachricht, die du als Text geschrieben hast, lässt sich bearbeiten</target>
            </trans-unit>
            <trans-unit id="error.editStale" resname="error.editStale">
                <source>The conversation changed since it was loaded. It has been reloaded; edit the message again.</source>
                <target>Die Unterhaltung hat sich seit dem Laden geändert. Sie wurde neu geladen; bearbeite die Nachricht bitte noch einmal.</target>
            </trans-unit>
            <trans-unit id="activity.title" resname="activity.title">
                <source>Activity</source>
                <target>Aktivität</target>
            </trans-unit>
            <trans-unit id="activity.button" resname="activity.button">
                <source>Show what the assistant does in this turn</source>
                <target>Anzeigen, was der Assistent in dieser Runde tut</target>
            </trans-unit>
            <trans-unit id="activity.tool" resname="activity.tool">
                <source>Tool: %s</source>
                <target>Werkzeug: %s</target>
            </trans-unit>
            <trans-unit id="activity.modelRound" resname="activity.modelRound">
                <source>Model call, round %d</source>
                <target>Modellaufruf, Runde %d</target>
            </trans-unit>
            <trans-unit id="activity.failed" resname="activity.failed">
                <source>failed</source>
                <target>fehlgeschlagen</target>
            </trans-unit>
            <trans-unit id="activity.approved" resname="activity.approved">
                <source>Approved by you</source>
                <target>Von dir freigegeben</target>
            </trans-unit>
            <trans-unit id="activity.denied" resname="activity.denied">
                <source>Denied by you</source>
                <target>Von dir abgelehnt</target>
            </trans-unit>
            <trans-unit id="activity.waiting" resname="activity.waiting">
                <source>Waiting for your approval</source>
                <target>Wartet auf deine Freigabe</target>
            </trans-unit>
            <trans-unit id="activity.working" resname="activity.working">
                <source>Working…</source>
                <target>Arbeitet …</target>
            </trans-unit>
            <trans-unit id="activity.empty" resname="activity.empty">
                <source>No steps in this turn yet.</source>
                <target>In dieser Runde noch keine Schritte.</target>
            </trans-unit>
            <trans-unit id="activity.close" resname="activity.close">
                <source>Hide the activity list</source>
                <target>Aktivitätsliste ausblenden</target>
            </trans-unit>
            <trans-unit id="widget.title" resname="widget.title">
                <source>AI Chat</source>
                <target>KI-Chat</target>
            </trans-unit>
            <trans-unit id="widget.description" resname="widget.description">
                <source>Your most recent AI chats, opened in the chat panel with one click.</source>
                <target>Deine letzten KI-Chats, mit einem Klick im Chat-Panel geöffnet.</target>
            </trans-unit>
            <trans-unit id="widget.openConversation" resname="widget.openConversation">
                <source>Open in the chat panel</source>
                <target>Im Chat-Panel öffnen</target>
            </trans-unit>
            <trans-unit id="widget.empty" resname="widget.empty">
                <source>No chats yet.</source>
                <target>Noch keine Chats.</target>
            </trans-unit>
            <trans-unit id="widget.openModule" resname="widget.openModule">
                <source>Open the chat module</source>
                <target>Chat-Modul öffnen</target>
            </trans-unit>
        </body>
    </file>
</xliff>
