<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="messages" date="2025-01-01T00:00:00Z" product-name="nr_mcp_agent">
        <body>
            <!-- Panel header -->
            <trans-unit id="panel.title" resname="panel.title">
                <source>AI Chat</source>
            </trans-unit>
            <trans-unit id="panel.collapse" resname="panel.collapse">
                <source>Minimize</source>
            </trans-unit>
            <trans-unit id="panel.maximize" resname="panel.maximize">
                <source>Maximize</source>
            </trans-unit>
            <trans-unit id="panel.restore" resname="panel.restore">
                <source>Restore</source>
            </trans-unit>
            <trans-unit id="panel.popOut" resname="panel.popOut">
                <source>Open in a separate window</source>
            </trans-unit>
            <trans-unit id="panel.close" resname="panel.close">
                <source>Close</source>
            </trans-unit>
            <trans-unit id="panel.resize" resname="panel.resize">
                <source>Resize panel</source>
            </trans-unit>

            <!-- Sidebar -->
            <trans-unit id="sidebar.show" resname="sidebar.show">
                <source>Show sidebar</source>
            </trans-unit>
            <trans-unit id="sidebar.hide" resname="sidebar.hide">
                <source>Hide sidebar</source>
            </trans-unit>

            <!-- Conversations -->
            <trans-unit id="conversations.title" resname="conversations.title">
                <source>Chats</source>
            </trans-unit>
            <trans-unit id="conversations.new" resname="conversations.new">
                <source>New chat</source>
            </trans-unit>
            <trans-unit id="conversations.empty" resname="conversations.empty">
                <source>No chats yet. Start a new one!</source>
            </trans-unit>
            <trans-unit id="conversations.select" resname="conversations.select">
                <source>Select chat...</source>
            </trans-unit>
            <trans-unit id="conversations.newConversation" resname="conversations.newConversation">
                <source>New chat</source>
            </trans-unit>
            <trans-unit id="conversations.pin" resname="conversations.pin">
                <source>Pin</source>
            </trans-unit>
            <trans-unit id="conversations.unpin" resname="conversations.unpin">
                <source>Unpin</source>
            </trans-unit>
            <trans-unit id="conversations.archive" resname="conversations.archive">
                <source>Archive</source>
            </trans-unit>
            <trans-unit id="conversations.archiveConfirm" resname="conversations.archiveConfirm">
                <source>Archive this chat? You can find it later in the full chat module.</source>
            </trans-unit>
            <trans-unit id="conversations.more" resname="conversations.more">
                <source>More (%d)</source>
            </trans-unit>
            <trans-unit id="conversations.moreTitle" resname="conversations.moreTitle">
                <source>Show the conversations that do not fit in the row</source>
            </trans-unit>
            <trans-unit id="conversations.search" resname="conversations.search">
                <source>Search conversations</source>
            </trans-unit>
            <trans-unit id="conversations.noMatch" resname="conversations.noMatch">
                <source>No conversation matches</source>
            </trans-unit>
            <trans-unit id="conversations.export" resname="conversations.export">
                <source>Export conversation as Markdown</source>
            </trans-unit>
            <trans-unit id="conversations.exportShort" resname="conversations.exportShort">
                <source>Export</source>
            </trans-unit>
            <trans-unit id="export.roleUser" resname="export.roleUser">
                <source>You</source>
            </trans-unit>
            <trans-unit id="export.roleAssistant" resname="export.roleAssistant">
                <source>Assistant</source>
            </trans-unit>
            <trans-unit id="export.attachment" resname="export.attachment">
                <source>Attachment</source>
            </trans-unit>

            <!-- Chat -->
            <trans-unit id="chat.selectOrCreate" resname="chat.selectOrCreate">
                <source>Select or start a chat</source>
            </trans-unit>
            <trans-unit id="chat.empty.title" resname="chat.empty.title">
                <source>Ask about this TYPO3 installation</source>
            </trans-unit>
            <trans-unit id="chat.empty.body" resname="chat.empty.body">
                <source>The assistant can look things up in this installation and act on them — find pages and content, explain how something is configured, and prepare changes for you to review.</source>
            </trans-unit>
            <trans-unit id="chat.empty.hint" resname="chat.empty.hint">
                <source>Earlier conversations stay in the list on the left.</source>
            </trans-unit>
            <trans-unit id="chat.empty.hintTabs" resname="chat.empty.hintTabs">
                <source>Earlier conversations are in the row above; the ones that do not fit in it are under “More”.</source>
            </trans-unit>
            <trans-unit id="chat.notAvailable" resname="chat.notAvailable">
                <source>Chat not available. Please contact your administrator.</source>
            </trans-unit>
            <trans-unit id="chat.processing" resname="chat.processing">
                <source>Processing...</source>
            </trans-unit>
            <trans-unit id="chat.approvalPending" resname="chat.approvalPending">
                <source>Waiting for approval</source>
            </trans-unit>
            <trans-unit id="chat.approvalPendingDetail" resname="chat.approvalPendingDetail">
                <source>This step writes data and needs an approval before it runs.</source>
            </trans-unit>
            <trans-unit id="chat.approvalOpen" resname="chat.approvalOpen">
                <source>Open the run in AI Tasks</source>
            </trans-unit>
            <trans-unit id="chat.approvalApprove" resname="chat.approvalApprove">
                <source>Approve</source>
            </trans-unit>
            <trans-unit id="chat.approvalGranted" resname="chat.approvalGranted">
                <source>Approval granted — the assistant is carrying the step out.</source>
            </trans-unit>
            <trans-unit id="chat.approvalDenied" resname="chat.approvalDenied">
                <source>Approval denied — the step was not carried out.</source>
            </trans-unit>
            <trans-unit id="chat.approvalDeny" resname="chat.approvalDeny">
                <source>Deny</source>
            </trans-unit>
            <trans-unit id="chat.approvalPreview" resname="chat.approvalPreview">
                <source>What this call would do</source>
            </trans-unit>
            <trans-unit id="chat.approvalPreviewUnavailable" resname="chat.approvalPreviewUnavailable">
                <source>No preview — you are deciding without one</source>
            </trans-unit>
            <trans-unit id="chat.approvalPreviewStale" resname="chat.approvalPreviewStale">
                <source>This record changed after the preview you approved, so nothing was written. The preview shows its current state — please check it and decide again.</source>
            </trans-unit>
            <trans-unit id="chat.approvalArguments" resname="chat.approvalArguments">
                <source>Arguments</source>
            </trans-unit>
            <trans-unit id="chat.approvalToolGone" resname="chat.approvalToolGone">
                <source>The tool for this call is no longer registered.</source>
            </trans-unit>
            <trans-unit id="chat.approvalUnreadable" resname="chat.approvalUnreadable">
                <source>This run cannot be read here. Open it in AI Tasks.</source>
            </trans-unit>
            <trans-unit id="chat.errorPrefix" resname="chat.errorPrefix">
                <source>Error:</source>
            </trans-unit>
            <trans-unit id="chat.retry" resname="chat.retry">
                <source>Retry</source>
            </trans-unit>
            <trans-unit id="chat.dismiss" resname="chat.dismiss">
                <source>Dismiss</source>
            </trans-unit>
            <trans-unit id="chat.send" resname="chat.send">
                <source>Send</source>
            </trans-unit>
            <trans-unit id="chat.placeholder" resname="chat.placeholder">
                <source>Ask anything...</source>
            </trans-unit>
            <trans-unit id="chat.connectionLost" resname="chat.connectionLost">
                <source>Connection lost — reconnecting...</source>
            </trans-unit>
            <trans-unit id="chat.messageTooLong" resname="chat.messageTooLong">
                <source>Message exceeds %d character limit</source>
            </trans-unit>
            <trans-unit id="chat.nothingSaved" resname="chat.nothingSaved">
                <source>Nothing was saved in this step: the answer reads like a finished change, but no record was written.</source>
            </trans-unit>
            <trans-unit id="chat.runFinishedOutside" resname="chat.runFinishedOutside">
                <source>The approval was decided outside this chat, and the run has finished there. It wrote: %s. Its answer is under AI Tasks.</source>
            </trans-unit>
            <trans-unit id="chat.runFinishedOutsideNothingWritten" resname="chat.runFinishedOutsideNothingWritten">
                <source>The approval was decided outside this chat, and the run has finished there without writing anything. Its answer is under AI Tasks.</source>
            </trans-unit>

            <!-- Tool messages -->
            <trans-unit id="tool.output" resname="tool.output">
                <source>Tool result (click to expand)</source>
            </trans-unit>

            <!-- API refusals shown in the chat notice -->
            <trans-unit id="error.approvalNotAllowed" resname="error.approvalNotAllowed">
                <source>Not allowed to decide approvals</source>
            </trans-unit>
            <trans-unit id="error.notAwaitingApproval" resname="error.notAwaitingApproval">
                <source>Conversation is not waiting for an approval</source>
            </trans-unit>
            <trans-unit id="error.decisionInFlight" resname="error.decisionInFlight">
                <source>An approval decision for this conversation is still being carried out</source>
            </trans-unit>
            <trans-unit id="error.conversationProcessing" resname="error.conversationProcessing">
                <source>Conversation is already processing</source>
            </trans-unit>
            <trans-unit id="error.notResumable" resname="error.notResumable">
                <source>Conversation is not resumable</source>
            </trans-unit>
            <trans-unit id="error.conversationNotFound" resname="error.conversationNotFound">
                <source>Conversation not found</source>
            </trans-unit>
            <trans-unit id="error.accessDenied" resname="error.accessDenied">
                <source>Access denied</source>
            </trans-unit>
            <trans-unit id="error.approvalStillPending" resname="error.approvalStillPending">
                <source>This step is still waiting for a decision. Approve or deny it on the card — a message does not approve it.</source>
            </trans-unit>
            <trans-unit id="error.providerNotConfigured" resname="error.providerNotConfigured">
                <source>The AI provider is not set up. Please contact your administrator.</source>
            </trans-unit>
            <trans-unit id="error.chatNotConfigured" resname="error.chatNotConfigured">
                <source>The AI chat is not set up. Please contact your administrator.</source>
            </trans-unit>
            <trans-unit id="error.openProviders" resname="error.openProviders">
                <source>Open the LLM providers</source>
            </trans-unit>
            <trans-unit id="error.openTasks" resname="error.openTasks">
                <source>Open the LLM tasks</source>
            </trans-unit>

            <!-- Attachments -->
            <trans-unit id="attachment.attach" resname="attachment.attach">
                <source>Attach file</source>
            </trans-unit>
            <trans-unit id="attachment.upload" resname="attachment.upload">
                <source>Upload file</source>
            </trans-unit>
            <trans-unit id="attachment.fromFal" resname="attachment.fromFal">
                <source>From file list</source>
            </trans-unit>
            <trans-unit id="attachment.notSupported" resname="attachment.notSupported">
                <source>Your LLM model does not support file attachments</source>
            </trans-unit>
            <trans-unit id="attachment.tooLarge" resname="attachment.tooLarge">
                <source>File too large (max %d MB)</source>
            </trans-unit>
            <trans-unit id="attachment.limitReached" resname="attachment.limitReached">
                <source>Maximum 5 files per conversation reached</source>
            </trans-unit>
            <trans-unit id="attachment.invalidType" resname="attachment.invalidType">
                <source>File type not supported</source>
            </trans-unit>
            <trans-unit id="attachment.file" resname="attachment.file">
                <source>File</source>
            </trans-unit>
            <trans-unit id="attachment.remove" resname="attachment.remove">
                <source>Remove attachment</source>
            </trans-unit>
            <trans-unit id="attachment.uploading" resname="attachment.uploading">
                <source>Uploading...</source>
            </trans-unit>
            <trans-unit id="attachment.fileMissing" resname="attachment.fileMissing">
                <source>File no longer available</source>
            </trans-unit>

            <!-- FAL picker -->
            <trans-unit id="fal_picker_label" resname="fal_picker_label">
                <source>Select file</source>
            </trans-unit>
            <trans-unit id="fal_picker_unavailable" resname="fal_picker_unavailable">
                <source>FAL picker is not available</source>
            </trans-unit>
            <trans-unit id="fal_picker_popup_blocked" resname="fal_picker_popup_blocked">
                <source>Popup was blocked. Please disable your popup blocker.</source>
            </trans-unit>
        </body>
    </file>
</xliff>
