    <file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2026-10-08T00:00:00Z" product-name="nr_mcp_agent">
        <body>
            <trans-unit id="preset.title" resname="preset.title">
                <source>AI Assistant</source>
                <target>KI-Assistent</target>
            </trans-unit>
            <trans-unit id="preset.description" resname="preset.description">
                <source>Improve your website with the AI assistant: ask a question, edit a page, create content, return to your recent chats, see what is open, and go through a page or the whole website.</source>
                <target>Verbessere deine Website mit dem KI-Assistenten: eine eigene Frage, Seiten bearbeiten, Inhalte erstellen, deine letzten Chats, offene Baustellen und Prüfungen für eine Seite oder die ganze Website.</target>
            </trans-unit>
            <trans-unit id="group.title" resname="group.title">
                <source>AI Assistant</source>
                <target>KI-Assistent</target>
            </trans-unit>
            <trans-unit id="improve.title" resname="improve.title">
                <source>Improve a page</source>
                <target>Eine Seite verbessern</target>
            </trans-unit>
            <trans-unit id="improve.description" resname="improve.description">
                <source>Choose a guided tour; the AI assistant asks for the page and goes through it with you step by step.</source>
                <target>Wähle einen geführten Rundgang – der KI-Assistent fragt nach der Seite und geht sie Schritt für Schritt mit dir durch.</target>
            </trans-unit>
            <trans-unit id="improve.noSkills" resname="improve.noSkills">
                <source>No guided tours are set up yet. Your administrator can set them up.</source>
                <target>Es sind noch keine geführten Rundgänge eingerichtet. Deine Administration kann sie einrichten.</target>
            </trans-unit>
            <trans-unit id="page.suggested" resname="page.suggested">
                <source>Recommended</source>
                <target>Empfohlen</target>
            </trans-unit>
            <trans-unit id="suggestion.reason.openPoint" resname="suggestion.reason.openPoint">
                <source>Open point from a guided tour</source>
                <target>Offener Punkt aus einem Rundgang</target>
            </trans-unit>
            <trans-unit id="suggestion.reason.missingDescription" resname="suggestion.reason.missingDescription">
                <source>Meta description missing</source>
                <target>Meta Description fehlt</target>
            </trans-unit>
            <trans-unit id="suggestion.reason.shortTitle" resname="suggestion.reason.shortTitle">
                <source>Page title too short</source>
                <target>Seitentitel zu kurz</target>
            </trans-unit>
            <trans-unit id="suggestion.reason.missingSocialImage" resname="suggestion.reason.missingSocialImage">
                <source>Social media image missing</source>
                <target>Social-Media-Bild fehlt</target>
            </trans-unit>
            <trans-unit id="page.untitled" resname="page.untitled">
                <source>Page without a title</source>
                <target>Seite ohne Titel</target>
            </trans-unit>
            <trans-unit id="tasks.title" resname="tasks.title">
                <source>Frequent tasks</source>
                <target>Häufige Aufgaben</target>
            </trans-unit>
            <trans-unit id="tasks.description" resname="tasks.description">
                <source>Start the tasks you do most often directly in the AI chat.</source>
                <target>Starte deine häufigsten Aufgaben direkt im KI-Chat.</target>
            </trans-unit>
            <trans-unit id="tasks.empty" resname="tasks.empty">
                <source>No frequent tasks are set up yet. Your administrator can set them up.</source>
                <target>Es sind noch keine häufigen Aufgaben eingerichtet. Deine Administration kann sie einrichten.</target>
            </trans-unit>
            <trans-unit id="recommendations.title" resname="recommendations.title">
                <source>Recommended for your website</source>
                <target>Für deine Website empfohlen</target>
            </trans-unit>
            <trans-unit id="recommendations.description" resname="recommendations.description">
                <source>What the AI assistant can count on your website, such as images without an alt text and pages without a meta description, and the points guided tours left open.</source>
                <target>Was der KI-Assistent auf deiner Website zählen kann, etwa Bilder ohne Alt-Text und Seiten ohne Meta Description, und was aus geführten Rundgängen noch offen ist.</target>
            </trans-unit>
            <trans-unit id="recommendations.empty" resname="recommendations.empty">
                <source>No open recommendations. When the AI assistant finds something to improve during a guided tour, it appears here.</source>
                <target>Keine offenen Empfehlungen. Findet der KI-Assistent bei einem geführten Rundgang etwas zu verbessern, erscheint es hier.</target>
            </trans-unit>
            <trans-unit id="recommendations.start" resname="recommendations.start">
                <source>%1$s on “%2$s”</source>
                <target>%1$s für „%2$s“</target>
            </trans-unit>
            <trans-unit id="prompt.title" resname="prompt.title">
                <source>AI Assistant</source>
                <target>AI Assistant</target>
            </trans-unit>
            <trans-unit id="prompt.description" resname="prompt.description">
                <source>Ask the AI assistant a question of your own, without choosing a tour or a page first; the chat opens with your question.</source>
                <target>Stell dem KI-Assistenten eine eigene Frage, ohne vorher einen Rundgang oder eine Seite zu wählen – der Chat öffnet sich mit deiner Frage.</target>
            </trans-unit>
            <trans-unit id="prompt.question" resname="prompt.question">
                <source>What would you like to do?</source>
                <target>Was möchtest du tun?</target>
            </trans-unit>
            <trans-unit id="prompt.placeholder" resname="prompt.placeholder">
                <source>Ask the assistant …</source>
                <target>Frag den Assistant …</target>
            </trans-unit>
            <trans-unit id="prompt.send" resname="prompt.send">
                <source>Send</source>
                <target>Senden</target>
            </trans-unit>
            <trans-unit id="skill.seo-optimieren.title" resname="skill.seo-optimieren.title">
                <source>Optimise SEO</source>
                <target>SEO optimieren</target>
            </trans-unit>
            <trans-unit id="skill.seo-optimieren.description" resname="skill.seo-optimieren.description">
                <source>Check and improve the page title, meta description and headings for search engines.</source>
                <target>Seitentitel, Meta Description und Überschriften für Suchmaschinen prüfen und verbessern.</target>
            </trans-unit>
            <trans-unit id="skill.inhalt-verbessern.title" resname="skill.inhalt-verbessern.title">
                <source>Improve content</source>
                <target>Inhalt verbessern</target>
            </trans-unit>
            <trans-unit id="skill.inhalt-verbessern.description" resname="skill.inhalt-verbessern.description">
                <source>Check the texts of the page for clarity, structure and spelling, and improve them.</source>
                <target>Texte der Seite auf Verständlichkeit, Aufbau und Rechtschreibung prüfen und verbessern.</target>
            </trans-unit>
            <trans-unit id="websiteCheck.title" resname="websiteCheck.title">
                <source>Check website</source>
                <target>Website prüfen</target>
            </trans-unit>
            <trans-unit id="websiteCheck.description" resname="websiteCheck.description">
                <source>Site-wide checks of your website, such as images without an alt text and pages without a meta description.</source>
                <target>Websiteweite Prüfungen, zum Beispiel Bilder ohne Alt-Text und Seiten ohne Meta Description.</target>
            </trans-unit>
            <trans-unit id="websiteCheck.altTexts" resname="websiteCheck.altTexts">
                <source>Missing alt texts</source>
                <target>Fehlende Alt-Texte</target>
            </trans-unit>
            <trans-unit id="altTexts.label" resname="altTexts.label">
                <source>Images without alt text</source>
                <target>Bilder ohne Alt-Text</target>
            </trans-unit>
            <trans-unit id="altTexts.onPage" resname="altTexts.onPage">
                <source>on 1 page</source>
                <target>auf 1 Seite</target>
            </trans-unit>
            <trans-unit id="altTexts.onPages" resname="altTexts.onPages">
                <source>on %d pages</source>
                <target>auf %d Seiten</target>
            </trans-unit>
            <trans-unit id="altTexts.inRecord" resname="altTexts.inRecord">
                <source>in 1 record</source>
                <target>in 1 Datensatz</target>
            </trans-unit>
            <trans-unit id="altTexts.inRecords" resname="altTexts.inRecords">
                <source>in %d records</source>
                <target>in %d Datensätzen</target>
            </trans-unit>
            <trans-unit id="altTexts.foundBoth" resname="altTexts.foundBoth">
                <source>Found %1$s and %2$s</source>
                <target>%1$s und %2$s gefunden</target>
            </trans-unit>
            <trans-unit id="altTexts.foundOne" resname="altTexts.foundOne">
                <source>Found %s</source>
                <target>%s gefunden</target>
            </trans-unit>
            <trans-unit id="altTexts.view" resname="altTexts.view">
                <source>View</source>
                <target>Ansehen</target>
            </trans-unit>
            <trans-unit id="improve.intro" resname="improve.intro">
                <source>Choose a page, and we’ll go through it together step by step.</source>
                <target>Wähle eine Seite, und wir gehen sie Schritt für Schritt gemeinsam durch.</target>
            </trans-unit>
            <trans-unit id="tasks.intro" resname="tasks.intro">
                <source>Start the tasks you do most often in one click.</source>
                <target>Starte deine häufigsten Aufgaben mit einem Klick.</target>
            </trans-unit>
            <trans-unit id="websiteCheck.intro" resname="websiteCheck.intro">
                <source>I check all pages at once and show you where something is missing.</source>
                <target>Ich prüfe alle Seiten auf einmal und zeige dir, wo es hakt.</target>
            </trans-unit>
            <trans-unit id="websiteCheck.descriptions" resname="websiteCheck.descriptions">
                <source>Pages without a meta description</source>
                <target>Seiten ohne Meta Description</target>
            </trans-unit>
            <trans-unit id="editPage.title" resname="editPage.title">
                <source>Edit a page</source>
                <target>Seite bearbeiten</target>
            </trans-unit>
            <trans-unit id="editPage.description" resname="editPage.description">
                <source>Choose a page in the page tree and change its content together with the AI assistant.</source>
                <target>Wähle eine Seite im Seitenbaum und ändere ihre Inhalte gemeinsam mit dem KI-Assistenten.</target>
            </trans-unit>
            <trans-unit id="editPage.intro" resname="editPage.intro">
                <source>Choose a page, and we’ll change its content together.</source>
                <target>Wähle eine Seite, und wir ändern ihre Inhalte gemeinsam.</target>
            </trans-unit>
            <trans-unit id="editPage.action" resname="editPage.action">
                <source>Choose a page to edit</source>
                <target>Seite zum Bearbeiten auswählen</target>
            </trans-unit>
            <trans-unit id="create.title" resname="create.title">
                <source>Create content</source>
                <target>Inhalte erstellen</target>
            </trans-unit>
            <trans-unit id="create.description" resname="create.description">
                <source>Create new pages and news together with the AI assistant.</source>
                <target>Lege neue Seiten und News gemeinsam mit dem KI-Assistenten an.</target>
            </trans-unit>
            <trans-unit id="create.intro" resname="create.intro">
                <source>Tell me what you need, and we’ll create it together.</source>
                <target>Sag mir, was du brauchst, und wir legen es gemeinsam an.</target>
            </trans-unit>
            <trans-unit id="create.none" resname="create.none">
                <source>I can’t create new content for you here yet. Your administrator can enable the tools for it.</source>
                <target>Neue Inhalte kann ich hier noch nicht für dich anlegen. Deine Administration kann die passenden Werkzeuge freischalten.</target>
            </trans-unit>
            <trans-unit id="create.page" resname="create.page">
                <source>New page</source>
                <target>Neue Seite</target>
            </trans-unit>
            <trans-unit id="create.page.prefill" resname="create.page.prefill">
                <source>I would like to create a new page.</source>
                <target>Ich möchte eine neue Seite anlegen.</target>
            </trans-unit>
            <trans-unit id="create.news" resname="create.news">
                <source>News</source>
                <target>News</target>
            </trans-unit>
            <trans-unit id="create.news.prefill" resname="create.news.prefill">
                <source>I would like to create a news article.</source>
                <target>Ich möchte eine News anlegen.</target>
            </trans-unit>
            <trans-unit id="recommendations.intro" resname="recommendations.intro">
                <source>I’ve found a few things on your website that need work. Let’s tackle them together.</source>
                <target>Ich habe auf deiner Website ein paar Baustellen entdeckt. Lass sie uns gemeinsam angehen.</target>
            </trans-unit>
            <trans-unit id="recommendations.allDone" resname="recommendations.allDone">
                <source>I’ve checked: nothing is open right now. Well done!</source>
                <target>Ich habe nachgesehen: Gerade ist nichts offen. Gut gemacht!</target>
            </trans-unit>
            <trans-unit id="recommendations.points" resname="recommendations.points">
                <source>Still open from your guided tours</source>
                <target>Offen aus deinen Rundgängen</target>
            </trans-unit>
            <trans-unit id="altTexts.labelOne" resname="altTexts.labelOne">
                <source>Image without alt text</source>
                <target>Bild ohne Alt-Text</target>
            </trans-unit>
            <trans-unit id="altTexts.done" resname="altTexts.done">
                <source>No missing alt texts – great!</source>
                <target>Keine fehlenden Alt-Texte – super!</target>
            </trans-unit>
            <trans-unit id="tile.actionName" resname="tile.actionName">
                <source>%1$s: %2$d %3$s</source>
                <target>%1$s: %2$d %3$s</target>
            </trans-unit>
            <trans-unit id="descriptions.label" resname="descriptions.label">
                <source>Pages without a meta description</source>
                <target>Seiten ohne Meta Description</target>
            </trans-unit>
            <trans-unit id="descriptions.labelOne" resname="descriptions.labelOne">
                <source>Page without a meta description</source>
                <target>Seite ohne Meta Description</target>
            </trans-unit>
            <trans-unit id="descriptions.done" resname="descriptions.done">
                <source>Every page has a meta description – great!</source>
                <target>Jede Seite hat eine Meta Description – super!</target>
            </trans-unit>
            <trans-unit id="descriptions.firstPage" resname="descriptions.firstPage">
                <source>We’ll start with “%s”.</source>
                <target>Wir fangen mit „%s“ an.</target>
            </trans-unit>
            <trans-unit id="descriptions.start" resname="descriptions.start">
                <source>Start now</source>
                <target>Jetzt angehen</target>
            </trans-unit>
            <trans-unit id="descriptions.startName" resname="descriptions.startName">
                <source>%1$s: %2$d %3$s, with the SEO tour, starting with “%4$s”</source>
                <target>%1$s: %2$d %3$s, mit der SEO-Tour, beginnend mit „%4$s“</target>
            </trans-unit>
        </body>
