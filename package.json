{
  "name": "nr_mcp_agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "E2E test scaffolding for the nr_mcp_agent TYPO3 extension",
  "scripts": {
    "test:js": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:e2e": "npx playwright test --config=Build/tests/playwright/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --config=Build/tests/playwright/playwright.config.ts --headed",
    "test:e2e:report": "npx playwright show-report",
    "axe": "node landingpage/axe-audit.mjs",
    "test:landingpage": "node --test landingpage/render.test.mjs landingpage/verify-product-urls.test.mjs landingpage/docs-version-selector.test.mjs landingpage/docs-accessibility.test.mjs landingpage/redirect-stubs.test.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.0",
    "@playwright/test": "^1.58.2",
    "axe-core": "^4.13.0",
    "css-tree": "^3.2.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "lit": "^3.3.3"
  }
}
