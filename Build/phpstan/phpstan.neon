# SPDX-FileCopyrightText: Netresearch DTT GmbH

# The shared config sets level 10, treatPhpDocTypesAsCertain and the
# strictness flags; phpstan/extension-installer registers phpstan-typo3,
# phpat and the other PHPStan extensions.
includes:
    - %currentWorkingDirectory%/.Build/vendor/netresearch/typo3-ci-workflows/config/phpstan/phpstan.neon

parameters:
    paths:
        - ../../Classes
        - ../../Tests/Architecture
    scanDirectories:
        - ../../Tests/Architecture
    ignoreErrors:
        # phpoffice/phpspreadsheet is an optional suggested dependency (not required).
        # XlsxExtractor guards usage behind isAvailable(), but PHPStan cannot resolve
        # the classes when the package is not installed.
        - identifier: class.notFound
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        - identifier: method.nonObject
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        - identifier: foreach.nonIterable
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        - identifier: cast.string
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        - identifier: argument.type
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        # nr-llm 0.41 (ADR-214, nr-llm PRs 1023 and 1024): a pending call's
        # target and a write step's completeness, read by the open-point
        # adapters (ADR-022). Same rule as above, in both directions.
        - identifier: function.impossibleType
          path: ../../Classes/Service/OpenPoint/AppliedWrite.php
          reportUnmatched: false
        - identifier: class.notFound
          path: ../../Classes/Service/OpenPoint/AppliedWrite.php
          reportUnmatched: false
        - identifier: function.impossibleType
          path: ../../Classes/Service/OpenPoint/NrLlmCardTarget.php
          reportUnmatched: false
        - identifier: class.notFound
          path: ../../Classes/Service/OpenPoint/NrLlmCardTarget.php
          reportUnmatched: false
        - identifier: property.nonObject
          path: ../../Classes/Service/OpenPoint/NrLlmCardTarget.php
          reportUnmatched: false
        - identifier: argument.type
          path: ../../Classes/Service/OpenPoint/NrLlmCardTarget.php
          reportUnmatched: false
        - identifier: function.alreadyNarrowedType
          path: ../../Classes/Service/OpenPoint/AppliedWrite.php
          reportUnmatched: false
        - identifier: function.alreadyNarrowedType
          path: ../../Classes/Service/OpenPoint/NrLlmCardTarget.php
          reportUnmatched: false

services:
    -
        class: Netresearch\NrMcpAgent\Tests\Architecture\LayerDependencyTest
        tags:
            - phpat.test
    -
        class: Netresearch\NrMcpAgent\Tests\Architecture\DocumentExtractorArchitectureTest
        tags:
            - phpat.test
