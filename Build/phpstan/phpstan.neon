includes:
    - %currentWorkingDirectory%/.Build/vendor/saschaegerer/phpstan-typo3/extension.neon
    - %currentWorkingDirectory%/.Build/vendor/phpat/phpat/extension.neon

parameters:
    level: 10
    paths:
        - ../../Classes
        - ../../Tests/Architecture
    treatPhpDocTypesAsCertain: false
    scanDirectories:
        - ../../Tests/Architecture
    ignoreErrors:
        # phpoffice/phpspreadsheet is an optional suggested dependency (not required).
        # XlsxExtractor guards usage behind isAvailable(), but PHPStan cannot resolve
        # the classes when the package is not installed.
        - identifier: class.notFound
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        - identifier: method.nonObject
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        - identifier: foreach.nonIterable
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        - identifier: cast.string
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        - identifier: argument.type
          path: ../../Classes/Document/Extractor/XlsxExtractor.php
        # nr-llm 0.41 (ADR-214, nr-llm PR 1024) adds ApprovalDenialReason, the
        # decision's denialReason and the guarded cancel. The adapters check for
        # them at runtime, so they work on nr-llm before and after 0.41: the
        # first entries cover the symbols an earlier nr-llm lacks, the
        # alwaysTrue/alreadyNarrowedType ones the same checks against 0.41.
        # Drop the checks and these entries once the lock requires 0.41.
        - identifier: class.notFound
          path: ../../Classes/Service/ApprovalDecisionFactory.php
          reportUnmatched: false
        - identifier: argument.unknown
          path: ../../Classes/Service/ApprovalDecisionFactory.php
          reportUnmatched: false
        - identifier: return.type
          path: ../../Classes/Service/ApprovalDecisionFactory.php
          reportUnmatched: false
        - identifier: function.impossibleType
          path: ../../Classes/Service/PendingCallEffect.php
          reportUnmatched: false
        - identifier: class.notFound
          path: ../../Classes/Service/NrLlmWaitingRunCanceller.php
          reportUnmatched: false
        - identifier: method.notFound
          path: ../../Classes/Service/NrLlmWaitingRunCanceller.php
          reportUnmatched: false
        - identifier: argument.type
          path: ../../Classes/Service/NrLlmWaitingRunCanceller.php
          reportUnmatched: false
        - identifier: instanceof.alwaysTrue
          path: ../../Classes/Service/NrLlmWaitingRunCanceller.php
          reportUnmatched: false
        - identifier: function.alreadyNarrowedType
          path: ../../Classes/Service/NrLlmWaitingRunCanceller.php
          reportUnmatched: false
        - identifier: function.alreadyNarrowedType
          path: ../../Classes/Service/PendingCallEffect.php
          reportUnmatched: false

services:
    -
        class: Netresearch\NrMcpAgent\Tests\Architecture\LayerDependencyTest
        tags:
            - phpat.test
    -
        class: Netresearch\NrMcpAgent\Tests\Architecture\DocumentExtractorArchitectureTest
        tags:
            - phpat.test
