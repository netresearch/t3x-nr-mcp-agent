.claude/
node_modules/
# package-lock.json is committed: it pins the *development* toolchain —
# Playwright, axe, the test runner. Consumers of this extension resolve PHP
# through composer and never read it, so the library argument that keeps
# composer.lock out does not apply. Without it `npm ci` cannot run at all.
playwright-report/
test-results/
Build/tests/playwright/.auth/
.Build/
vendor/
# The Docker test runner writes the container's HOME and TYPO3's var/ into
# the working tree, so `runTests.sh` leaves both behind on every local run.
/home/
/var/
# TYPO3 extensions (libraries) must not commit composer.lock — each consumer
# and CI leg resolves dependencies for its own PHP/TYPO3 version.
composer.lock
.env
.env.local
.php-cs-fixer.cache
Documentation-GENERATED-temp/
.worktrees/
